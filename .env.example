# Copy to .env before running docker compose:   cp .env.example .env
# Never commit .env. Replace every value; generate random ones with:  openssl rand -hex 24
#
# The backend itself gets NO database password and NO JWT secret from here: vault/init.sh stores the
# database credentials in Vault, generates the JWT signing secret inside Vault, and the backend reads
# both from Vault after logging in with the AppRole below.

# Database (bootstraps the PostgreSQL container; copied into Vault by vault-init)
POSTGRES_DB=cipherchat
POSTGRES_USER=cipherchat
POSTGRES_PASSWORD=replace-with-a-random-db-password

# HashiCorp Vault, DEV MODE ONLY (in memory, unsealed). Root token for the Vault UI/CLI at http://localhost:8200
VAULT_DEV_ROOT_TOKEN=replace-with-a-random-dev-root-token
# AppRole login for the backend (dev). In production the secret ID is issued per deployment, never stored in a file.
VAULT_ROLE_ID=replace-with-a-random-role-id
VAULT_SECRET_ID=replace-with-a-random-secret-id

# Where the browser reaches each service
FRONTEND_ORIGIN=http://localhost:3000
API_URL=http://localhost:8080
