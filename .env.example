# Copy to .env before running docker compose:   cp .env.example .env
# Never commit .env. For anything beyond local testing, replace every value.

# Database (only reachable inside the compose network)
POSTGRES_DB=cipherchat
POSTGRES_USER=cipherchat
POSTGRES_PASSWORD=change-me-local-db-password

# JWT signing secret, at least 32 bytes. Generate a real one with:  openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0123456789

# Where the browser reaches each service
FRONTEND_ORIGIN=http://localhost:3000
API_URL=http://localhost:8080
