# Only needed if you run the jar yourself (java -jar). `./mvnw spring-boot:run` and Docker Compose
# need nothing from here. Secrets are NOT set here: the JWT secret and database credentials are read
# from Vault (secret/cipherchat) after an AppRole login.
VAULT_URI=http://localhost:8200
VAULT_ROLE_ID=replace-with-your-role-id
VAULT_SECRET_ID=replace-with-your-secret-id
# 5433 = the database port Docker Compose publishes on 127.0.0.1
DB_URL=jdbc:postgresql://localhost:5433/cipherchat
CORS_ALLOWED_ORIGIN=http://localhost:3000
ATTACHMENTS_DIR=./data/attachments
